NODE_ENV=production
PORT=3030
LOG_LEVEL=info
# 应用机走数据库内网。开发机从外网连时用 192.0.2.1:25432。
PG_HOST=192.168.9.109
PG_PORT=5432
PG_USER=message_center_prod_user
PG_PASSWORD=
PG_DATABASE=message_center_prod
PG_SSL=false
JWT_SECRET=
COOKIE_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SECRET_ENCRYPTION_KEY=
WEB_ORIGIN=https://msg.aimo.plus
# 五项都填才出现「使用统一账号登录」。回调必须等于 WEB_ORIGIN + /api/auth/oidc/callback。
